# ==========================================
# Events API - Variables de Entorno de Ejemplo
# ==========================================
# Copiá este archivo como .env para desarrollo local:
#   cp .env.example .env
# O en Windows PowerShell:
#   copy .env.example .env

# --- Servidor y Entorno ---
PORT=8080
NODE_ENV=development

# --- Base de Datos MongoDB ---
# En desarrollo local (MongoDB Atlas o local):
MONGO_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/events_db?retryWrites=true&w=majority
# Para Docker Compose local descomentar la siguiente línea:
# MONGO_URL=mongodb://mongo:27017/events_db

# --- Autenticación y Seguridad (JWT) ---
JWT_SECRET=super_secret_jwt_key_coderhouse_backend2
JWT_EXPIRES_IN=24h

# --- Servicio de Correos (Nodemailer) ---
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_app_password_de_16_caracteres
MAIL_FROM="API Eventos" <no-reply@eventos.com>
