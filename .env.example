# Variables de entorno requeridas
# Copiar este archivo como .env y completar los valores reales

PORT=8080
NODE_ENV=development

# Requerida para la base de datos (MongoDB Atlas)
MONGO_URI=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Requerida para firmar los JSON Web Tokens
JWT_SECRET=super_secret_key_change_me
