# Variables de entorno requeridas
# Copiar este archivo como .env y completar los valores reales

PORT=8080
NODE_ENV=development

# Requerida para la base de datos (MongoDB Atlas)
MONGO_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Requerida para firmar los JSON Web Tokens
JWT_SECRET=super_secret_key_change_me
JWT_EXPIRES_IN=1h

# Variables para envío de correos (Nodemailer)
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USER=tu_correo@gmail.com
MAIL_PASS=tu_password_de_aplicacion
MAIL_FROM="API Eventos" <no-reply@eventos.com>
